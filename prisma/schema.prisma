// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") //Prisma will get the env variables in the .env file, need to define explicitly if you wanna use another file
}

model User {
  id        Int             @id @default(autoincrement())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  email     String          @unique
  hash      String
  username  String?
  firstName String
  lastName  String
  dob       DateTime?
  stores    StoresOnUsers[]
}

model Store {
  id          Int             @id @default(autoincrement())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  name        String
  description String?
  users       StoresOnUsers[]
}

model StoresOnUsers {
  user              User            @relation(fields: [userId], references: [id])
  userId            Int
  store             Store           @relation(fields: [storeId], references: [id])
  storeId           Int
  assignedAt        DateTime        @default(now())
  assignedBy        String
  permission        StorePermission @relation(fields: [storePermissionId], references: [id])
  storePermissionId Int

  @@id([userId, storeId])
}

model StorePermission {
  id            Int             @id @default(autoincrement())
  name          String
  StoresOnUsers StoresOnUsers[]
}
