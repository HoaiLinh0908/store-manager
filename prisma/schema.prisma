// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") //Prisma will get the env variables in the .env file, need to define explicitly if you wanna use another file
}

model User {
  id        Int             @id @default(autoincrement())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  email     String          @unique
  hash      String
  username  String?
  firstName String
  lastName  String
  dob       DateTime?
  stores    StoresOnUsers[]
  status    String
}

model Store {
  id          Int             @id @default(autoincrement())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  name        String
  description String?
  status      String
  users       StoresOnUsers[]
  products    Product[]
  expenses    Expense[]
  bills       Bill[]
  Report      Report[]
}

model StoresOnUsers {
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId    Int
  assignedAt DateTime @default(now())
  assignedBy String
  permission String

  @@id([userId, storeId])
}

model StorePermission {
  id   Int    @id @default(autoincrement())
  name String
}

model Product {
  id          Int          @id @default(autoincrement())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String
  name        String
  description String?
  price       BigInt
  cost        BigInt
  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId     Int
  status      String
  bills       ItemOnBill[]
}

model Bill {
  id        Int          @id @default(autoincrement())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  createdBy String
  amount    BigInt
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId   Int
  status    String
  items     ItemOnBill[]
}

model ItemOnBill {
  assignAt  DateTime @default(now())
  assignBy  String
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId    Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  quantity  Int

  @@id([productId, billId])
}

model Expense {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  name      String
  detail    String
  amount    BigInt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId   Int
  status    String
}

model Report {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  name      String
  detail    String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId   Int
  status    String
}
