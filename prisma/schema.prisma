// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") //Prisma will get the env variables in the .env file, need to define explicitly if you wanna use another file
}

model User {
  id        Int             @id @default(autoincrement())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  email     String          @unique
  hash      String
  username  String?
  firstName String
  lastName  String
  dob       DateTime?
  stores    StoresOnUsers[]
  status    String
}

model Store {
  id          Int             @id @default(autoincrement())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  name        String
  description String?
  users       StoresOnUsers[]
  status      String
}

model StoresOnUsers {
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId    Int
  assignedAt DateTime @default(now())
  assignedBy String
  permission String

  @@id([userId, storeId])
}

model StorePermission {
  id   Int    @id @default(autoincrement())
  name String
}
